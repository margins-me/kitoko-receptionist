# Copy to apps/web/.env.local for local development (never commit real values).
# See docs/architecture.md for where each value comes from.

# Supabase (local: `pnpm db:start` prints these; hosted: Project settings → API)
SUPABASE_URL=http://127.0.0.1:54531
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54531
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL (PayPal return URLs, links sent in messages)
SITE_URL=http://localhost:3300

# Claude (Anthropic API). Without a key, set AGENT_FAKE=1 for a scripted dev model.
ANTHROPIC_API_KEY=
# Client receptionist (web chat, WhatsApp) and pro assistant models. AGENT_MODEL is the pro's fallback.
AGENT_MODEL_CLIENT=claude-haiku-5-5
AGENT_MODEL_PRO=claude-sonnet-5-5
AGENT_MODEL=claude-sonnet-5-5
AGENT_FAKE=

# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox).
# PAYPAL_ENV=fake runs an in-process fake PayPal (local dev and tests only).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=

# WhatsApp Cloud API (Meta). `log` prints messages instead of sending them.
WHATSAPP_TRANSPORT=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v24.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DEMO_PRO=aicha.braids

# Vercel cron (apps/web/vercel.json → GET /api/cron/keepalive sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=
